  "global": {"resolve_timeout": "5m"},
  "route": {
    "receiver": "unconfigured",
    "group_by": ["alertname", "job", "instance"],
    "group_wait": "15s",
    "group_interval": "1m",
    "repeat_interval": "4h"
  },
  "receivers": [{"name": "unconfigured"}],
  "templates": ["/opt/phome/config/alertmanager-telegram.tmpl"]
}
